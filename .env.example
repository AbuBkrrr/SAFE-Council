# ---------- Database ----------
DATABASE_URL="postgresql://user:password@localhost:5432/safecouncil?schema=public"

# ---------- Auth ----------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"
TOTP_ISSUER="SAFE Council"

# ---------- Platform URL ----------
NEXT_PUBLIC_PLATFORM_URL="http://localhost:3000"

# ---------- Supabase Storage ----------
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Email (Resend) ----------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@safefoundationafrica.org"

# ---------- SMS / WhatsApp (Termii) ----------
TERMII_API_KEY=""
TERMII_SENDER_ID="SAFECouncil"

# ---------- Cron ----------
CRON_SECRET="generate-with-openssl-rand-hex-32"

# ---------- Safeguarding ----------
SAFEGUARDING_ALERT_MODE="digest"
SAFEGUARDING_DIGEST_HOUR="18"
SAFEGUARDING_ALERT_CC_DEPUTY="true"

# ---------- Optional monitoring ----------
SENTRY_DSN=""
