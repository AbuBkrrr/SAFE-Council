// SAFE Council Digital Platform ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Prisma schema
// Single source of truth for the data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SuperAdmin
  ProgramManager
  Facilitator
  MELead
  AmanahGuardian
  DeputyAmanahGuardian
  FinanceOfficer
  CommunicationsOfficer
  Participant
  Donor
  Partner
  Government
}

enum UserStatus {
  Active
  Inactive
  Suspended
}

enum ParticipantStatus {
  Pending
  Active
  Completed
  Dropped
  Transferred
  LostToFollowUp
}

enum Gender {
  Male
  Female
}

enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
}

enum Track {
  PreMarital
  PostMarital
}

enum CoupleStatus {
  Active
  Completed
  Separated
  Divorced
}

enum ProgramStatus {
  Active
  Inactive
}

enum CohortStatus {
  Planned
  Active
  Completed
  Cancelled
}

enum SessionStatus {
  Scheduled
  InProgress
  Completed
  Cancelled
}

enum FacilitatorRole {
  Lead
  CoFacilitator
  Assistant
}

enum AttendanceStatus {
  Present
  Absent
  Late
  Excused
}

enum CheckinMethod {
  QRCode
  Manual
}

enum EnrollmentType {
  Couple
  Individual
}

enum EnrollmentStatus {
  Active
  Completed
  Withdrawn
  Transferred
}

enum SurveyType {
  PreProgram
  PostProgram
  FollowUp6M
  FollowUp12M
  FollowUp24M
}

enum SurveyStatus {
  Draft
  Active
  Closed
}

enum QuestionType {
  MultipleChoice
  Likert
  Text
  Number
  Date
  File
}

enum ResponseStatus {
  InProgress
  Completed
  Abandoned
  LostToFollowUp
}

enum IncidentStatus {
  New
  UnderInvestigation
  Referred
  Resolved
  Closed
}

enum CertificateStatus {
  Pending
  Issued
  Revoked
}

enum ControlGroupStatus {
  Waiting
  Enrolled
  Withdrawn
}

enum ControlGroupReason {
  Capacity
  Waitlist
  OptIn
}

enum NotificationChannel {
  Email
  SMS
  WhatsApp
  InApp
}

enum NotificationStatus {
  Pending
  Sent
  Failed
  Read
}

enum ResourceAudience {
  Public
  Participant
  Facilitator
  CohortOnly
  StaffOnly
}

enum ResourceStatus {
  Draft
  Published
  Archived
}

enum SafeguardingAlertStatus {
  Pending
  ResolvedContacted
  ResolvedNoAction
  EscalatedToIncident
}

enum ReminderType {
  PreProgramSurvey
  SessionReminder
  FollowUpSurvey
  CertificateReminder
}

enum ReminderStatus {
  Pending
  Sent
  Failed
  Skipped
}

// ============================================================
// USERS & ROLES
// ============================================================

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  status       UserStatus @default(Active)
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                      UserRoleAssignment[]
  participant                Participant?
  notifications              Notification[]
  auditLogs                  AuditLog[]
  incidentsReported          Incident[]        @relation("IncidentReporter")
  incidentsAssigned          Incident[]        @relation("IncidentAssignee")
  incidentAccessLogs         IncidentAccessLog[]
  resourcesUploaded          Resource[]
  cohortsLed                 CohortFacilitator[]
  sessionsLed                SessionFacilitator[]
  invitesSent                UserInvite[]      @relation("InviteSender")
  invitesReceived            UserInvite[]      @relation("InviteRecipient")
  safeguardingAlertsReviewed SafeguardingAlert[]
  certificatesRevoked        Certificate[]     @relation("CertificateRevoker")
  roleAssignmentsBy          UserRoleAssignment[] @relation("UserRoleAssigner")

  @@map("User")
}

model UserRoleAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  role       UserRole
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("UserRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, role])
  @@map("UserRole")
}

model UserInvite {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterId      String    @db.Uuid
  recipientId    String?   @db.Uuid
  recipientEmail String
  role           UserRole
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  inviter   User  @relation("InviteSender", fields: [inviterId], references: [id])
  recipient User? @relation("InviteRecipient", fields: [recipientId], references: [id])

  @@index([expiresAt])
  @@map("UserInvite")
}

// ============================================================
// PARTICIPANTS & COUPLES
// ============================================================

model Participant {
  id                              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                          String            @unique @db.Uuid
  participantCode                 String            @unique
  firstName                       String
  lastName                        String
  dateOfBirth                     DateTime?         @db.Date
  gender                          Gender
  address                         String?
  city                            String?
  state                           String?
  country                         String?
  maritalStatus                   MaritalStatus
  track                           Track
  status                          ParticipantStatus @default(Pending)
  documents                       Json              @default("{}")
  notificationPreferences         Json              @default("{\"sms\":true,\"whatsapp\":true,\"email\":true}")
  charterSignedAt                 DateTime?
  certificateName                 String?
  familyStabilityCovenantSignedAt DateTime?
  codeOfConductSignedAt           DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupleAsPartner1   Couple[]            @relation("CouplePartner1")
  coupleAsPartner2   Couple[]            @relation("CouplePartner2")
  enrollments        Enrollment[]
  attendance         Attendance[]
  responses          Response[]
  certificates       Certificate[]
  controlGroups      ControlGroup[]
  coupleInvitesSent  CoupleInvite[]
  reminders          ReminderSchedule[]
  safeguardingAlerts SafeguardingAlert[]
  examAttempts       ExamAttempt[]

  @@index([status])
  @@map("Participant")
}

model Couple {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coupleCode       String       @unique
  partner1Id       String       @db.Uuid
  partner2Id       String       @db.Uuid
  registrationDate DateTime     @default(now()) @db.Date
  track            Track
  status           CoupleStatus @default(Active)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  partner1    Participant  @relation("CouplePartner1", fields: [partner1Id], references: [id])
  partner2    Participant  @relation("CouplePartner2", fields: [partner2Id], references: [id])
  enrollments Enrollment[]

  @@index([status])
  @@map("Couple")
}

model CoupleInvite {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterId    String    @db.Uuid
  inviteeEmail String?
  inviteePhone String?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  declinedAt   DateTime?
  createdAt    DateTime  @default(now())

  inviter Participant @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@index([expiresAt])
  @@map("CoupleInvite")
}

// ============================================================
// PROGRAMS / COHORTS / SESSIONS
// ============================================================

model Program {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  tracks          Json
  durationWeeks   Int
  sessionsPerWeek Int           @default(1)
  status          ProgramStatus @default(Active)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cohorts Cohort[]

  @@map("Program")
}

model Cohort {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId       String       @db.Uuid
  name            String
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  location        String?
  maxParticipants Int
  status          CohortStatus @default(Planned)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  program           Program                  @relation(fields: [programId], references: [id])n  facilitators      CohortFacilitator[]n  sessions          Session[]n  enrollments       Enrollment[]n  resourceSnapshots CohortResourceSnapshot[]n  examAttempts      ExamAttempt[]n  cohorts           ResourceCohort[]

  @@map("Cohort")
}

model CohortFacilitator {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId      String          @db.Uuid
  facilitatorId String          @db.Uuid
  role          FacilitatorRole

  cohort      Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  facilitator User   @relation(fields: [facilitatorId], references: [id])

  @@unique([cohortId, facilitatorId])
  @@map("CohortFacilitator")
}

model Session {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId   String        @db.Uuid
  weekNumber Int
  title      String
  date       DateTime      @db.Date
  startTime  String
  endTime    String
  location   String?
  qrCode     String        @unique
  notes      String?
  status     SessionStatus @default(Scheduled)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  cohort       Cohort               @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  facilitators SessionFacilitator[]
  attendance   Attendance[]
  resources    SessionResource[]

  @@index([cohortId, date])
  @@map("Session")
}

model SessionFacilitator {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String          @db.Uuid
  facilitatorId String          @db.Uuid
  role          FacilitatorRole

  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  facilitator User    @relation(fields: [facilitatorId], references: [id])

  @@unique([sessionId, facilitatorId])
  @@map("SessionFacilitator")
}

// ============================================================
// ENROLLMENT
// ============================================================

model Enrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId       String           @db.Uuid
  coupleId       String?          @db.Uuid
  participantId  String?          @db.Uuid
  enrollmentType EnrollmentType
  status         EnrollmentStatus @default(Active)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  certificateId  String?          @unique @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  couple      Couple?      @relation(fields: [coupleId], references: [id])
  participant Participant? @relation(fields: [participantId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@index([cohortId])
  @@index([coupleId])
  @@index([participantId])
  @@map("Enrollment")
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String           @db.Uuid
  participantId String           @db.Uuid
  checkInTime   DateTime         @default(now())
  checkInMethod CheckinMethod
  status        AttendanceStatus @default(Present)
  notes         String?

  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([sessionId, participantId])
  @@index([participantId])
  @@map("Attendance")
}

// ============================================================
// SURVEYS
// ============================================================

model Survey {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  type        SurveyType
  language    String       @default("en")
  status      SurveyStatus @default(Draft)
  startDate   DateTime?    @db.Date
  endDate     DateTime?    @db.Date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questions Question[]
  responses Response[]

  @@map("Survey")
}

model Question {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId         String       @db.Uuid
  type             QuestionType
  text             String
  options          Json?
  required         Boolean      @default(false)
  conditionalLogic Json?
  orderIndex       Int
  scoringRule      Json?
  audioUrl         String?
  createdAt        DateTime     @default(now())

  survey  Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([surveyId, orderIndex])
  @@map("Question")
}

model Response {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId      String         @db.Uuid
  participantId String         @db.Uuid
  score         Decimal?       @db.Decimal(6, 2)
  status        ResponseStatus @default(InProgress)
  startedAt     DateTime       @default(now())
  completedAt   DateTime?

  survey             Survey              @relation(fields: [surveyId], references: [id])
  participant        Participant         @relation(fields: [participantId], references: [id])
  answers            Answer[]
  safeguardingAlerts SafeguardingAlert[]

  @@unique([surveyId, participantId])
  @@map("Response")
}

model Answer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId String   @db.Uuid
  questionId String   @db.Uuid
  value      Json
  createdAt  DateTime @default(now())

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([responseId, questionId])
  @@map("Answer")
}

// ============================================================
// SAFEGUARDING
// ============================================================

model Incident {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentCode     String         @unique
  reportedById     String?        @db.Uuid
  anonymousRef     String?
  reportedAt       DateTime       @default(now())
  incidentDate     DateTime?      @db.Date
  incidentTime     String?
  location         String?
  personDisclosing String?
  natureOfConcern  String?
  exactWords       String?
  observations     String?
  injuries         String?
  actionsTaken     String?
  referralsMade    String?
  status           IncidentStatus @default(New)
  assignedTo       String?        @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  reportedBy         User?               @relation("IncidentReporter", fields: [reportedById], references: [id])
  assignedToUser     User?               @relation("IncidentAssignee", fields: [assignedTo], references: [id])
  accessLogs         IncidentAccessLog[]
  safeguardingAlerts SafeguardingAlert[]

  @@index([status, createdAt])
  @@map("Incident")
}

model IncidentAccessLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String   @db.Uuid
  accessedBy String   @db.Uuid
  accessedAt DateTime @default(now())
  action     String

  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  accessedByUser User     @relation(fields: [accessedBy], references: [id])

  @@map("IncidentAccessLog")
}

model SafeguardingAlert {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId    String                  @db.Uuid
  participantId String                  @db.Uuid
  reason        String
  status        SafeguardingAlertStatus @default(Pending)
  reviewedById  String?                 @db.Uuid
  reviewedAt    DateTime?
  incidentId    String?                 @db.Uuid
  createdAt     DateTime                @default(now())

  response    Response    @relation(fields: [responseId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])
  reviewedBy  User?       @relation(fields: [reviewedById], references: [id])
  incident    Incident?   @relation(fields: [incidentId], references: [id])

  @@index([status, createdAt])
  @@map("SafeguardingAlert")
}

// ============================================================
// CERTIFICATES
// ============================================================

model Certificate {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId     String            @db.Uuid
  coupleId          String?           @db.Uuid
  programTrack      Track
  certificateNumber String            @unique
  verificationCode  String            @unique
  issuedDate        DateTime          @default(now()) @db.Date
  examScore         Decimal           @db.Decimal(5, 2)
  status            CertificateStatus @default(Pending)
  pdfUrl            String?
  signatureUrl      String?
  revokedAt         DateTime?
  revokedReason     String?
  revokedById       String?           @db.Uuid
  createdAt         DateTime          @default(now())

  participant Participant @relation(fields: [participantId], references: [id])
  revokedBy   User?       @relation("CertificateRevoker", fields: [revokedById], references: [id])
  enrollment  Enrollment?

  @@index([status])
  @@map("Certificate")
}

// ============================================================
// EXAM ATTEMPTS
// ============================================================

model ExamAttempt {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String    @db.Uuid
  cohortId      String    @db.Uuid
  attemptNumber Int
  score         Decimal   @db.Decimal(5, 2)
  passed        Boolean
  answers       Json
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id])
  cohort      Cohort      @relation(fields: [cohortId], references: [id])

  @@unique([participantId, cohortId, attemptNumber])
  @@index([participantId, cohortId])
  @@map("ExamAttempt")
}

// ============================================================
// CONTROL GROUP
// ============================================================

model ControlGroup {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String             @db.Uuid
  coupleId      String?            @db.Uuid
  registeredAt  DateTime           @default(now())
  reason        ControlGroupReason
  status        ControlGroupStatus @default(Waiting)
  enrolledAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  participant Participant @relation(fields: [participantId], references: [id])

  @@map("ControlGroup")
}

// ============================================================
// RESOURCES
// ============================================================

model Resource {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seriesId      String?          @db.Uuid
  title         String
  description   String?
  category      String
  audience      ResourceAudience
  language      String           @default("en")
  version       String           @default("1.0")
  fileKey       String
  fileType      String
  fileSizeBytes Int
  checksum      String
  isExternal    Boolean          @default(false)
  status        ResourceStatus   @default(Draft)
  publishedAt   DateTime?
  uploadedById  String           @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  uploadedBy      User                     @relation(fields: [uploadedById], references: [id])
  series          Resource?                @relation("ResourceSeries", fields: [seriesId], references: [id], onDelete: Restrict)
  versions        Resource[]               @relation("ResourceSeries")
  cohorts         ResourceCohort[]
  sessions        SessionResource[]
  cohortSnapshots CohortResourceSnapshot[]

  @@index([seriesId, publishedAt(sort: Desc)])
  @@index([audience, status])
  @@map("Resource")
}

model ResourceCohort {
  resourceId String @db.Uuid
  cohortId   String @db.Uuid

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([resourceId, cohortId])
  @@map("ResourceCohort")
}

model SessionResource {
  sessionId  String @db.Uuid
  resourceId String @db.Uuid

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([sessionId, resourceId])
  @@map("SessionResource")
}

model CohortResourceSnapshot {
  cohortId      String   @db.Uuid
  resourceId    String   @db.Uuid
  snapshottedAt DateTime @default(now())

  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([cohortId, resourceId])
  @@index([cohortId])
  @@map("CohortResourceSnapshot")
}

// ============================================================
// REMINDERS
// ============================================================

model ReminderSchedule {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId String         @db.Uuid
  type          ReminderType
  referenceId   String?        @db.Uuid
  scheduledFor  DateTime
  status        ReminderStatus @default(Pending)
  attempts      Int            @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  failureReason String?
  createdAt     DateTime       @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([participantId])
  @@map("ReminderSchedule")
}

// ============================================================
// CONTACT
// ============================================================

model Contact {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  message   String
  status    String    @default("Pending")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
  @@map("Contact")
}

// ============================================================
// AUDIT / NOTIFICATIONS
// ============================================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("AuditLog")
}

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationChannel
  title     String
  message   String
  status    NotificationStatus  @default(Pending)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("Notification")
}
